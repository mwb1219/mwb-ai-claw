# 复制本文件为 .env 并填入真实密钥（运行目录 .env 优先于系统环境变量，已被 .gitignore 排除）
# cp example-web/.env.example example-web/.env   # 然后从 IDE 或命令行以 example-web 为工作目录启动

# 默认模型
DEFAULT_MODEL=deepseek-chat
DEFAULT_BASE_URL=https://api.deepseek.com
DEFAULT_API_KEY=

# coder 专家（独立模型，留空则继承 DEFAULT_MODEL / DEFAULT_API_KEY）
CODER_MODEL=
CODER_API_KEY=

# researcher 专家
RESEARCHER_MODEL=
RESEARCHER_API_KEY=

# architect 专家
ARCHITECT_MODEL=
ARCHITECT_API_KEY=

# reviewer 专家
REVIEWER_MODEL=
REVIEWER_API_KEY=

# moderator 专家
MODERATOR_MODEL=
MODERATOR_API_KEY=

# 向量检索 Embedding（留空则继承默认模型配置。
# 注意：DeepSeek 主模型不支持 embeddings，要启用向量检索需配置专用 embedding 服务，
# 如 OpenAI 兼容的 text-embedding-3-small（base-url 形如 https://api.openai.com/v1）。
# 未配置时向量调用自动降级，hybrid 检索回退关键词。）
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 小模型提炼（成本优化；留空继承 DEFAULT_MODEL / DEFAULT_BASE_URL / DEFAULT_API_KEY）
SYNTHESIS_MODEL=
SYNTHESIS_BASE_URL=
SYNTHESIS_API_KEY=

# 存储后端（agent.storage.type）：file（默认，本地文件）| db（JDBC 持久化，需配下面 DB_* 变量）
# STORAGE_TYPE=file
# 数据库（agent.storage.type=db 时生效；默认嵌入式 H2，MySQL 兼容模式，数据重启清空，仅联调用）
# 生产 MySQL：填入连接信息，并先执行 example-web/src/main/resources/schema.sql 建表
# （或设 SQL_INIT_MODE=always 每次启动自动执行建表）
# DB_URL=jdbc:mysql://localhost:3306/clawdb?useSSL=false&serverTimezone=Asia/Shanghai
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# SQL_INIT_MODE=always
