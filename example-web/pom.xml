<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         example-web 独立工程：不随 mwb-ai-claw 仓库 reactor 构建，单独管理版本号。
         框架依赖 mwb-ai-claw-spring-boot-starter 为本地 SNAPSHOT：
           - 本地运行：仓库根目录执行 mvn install 后，从宿主机 ~/.m2 解析；
           - Docker 构建：docker compose 经 additional_contexts(host-m2) 注入宿主机 ~/.m2 的框架制品。
         ============================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.mwb1219</groupId>
    <artifactId>example-web</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>example-web</name>
    <description>Web 服务端示例（独立工程）：演示 mwb-ai-claw Spring Boot Starter 的 REST / SSE / WebSocket 接入方式</description>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 框架版本：跟随仓库当前 SNAPSHOT；正式发布后建议固定为已发布版本（如 1.0.1）以便脱离本地仓库独立构建 -->
        <mwb-ai-claw.version>1.0.3-SNAPSHOT</mwb-ai-claw.version>
        <!-- 覆盖 Lombok 版本以兼容 JDK 21 及新版语言服务器编译器（1.18.30 会触发 lombok.javac.Javac 初始化失败） -->
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencies>
        <!-- 框架 Starter：自动装配记忆 / LLM / 工具 / 编排 / 存储 / REST / WebSocket -->
        <dependency>
            <groupId>io.github.mwb1219</groupId>
            <artifactId>mwb-ai-claw-spring-boot-starter</artifactId>
            <version>${mwb-ai-claw.version}</version>
        </dependency>

        <!-- Web 服务端容器（spring.profiles.active=web 默认激活） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- JDBC 存储（agent.storage.type=db）：嵌入式 H2（联调用，MySQL 兼容模式）+ 生产 MySQL 驱动 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 生产 MySQL：DB_DRIVER=com.mysql.cj.jdbc.Driver（见 application.yml） -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Redis：召回索引（RediSearch）+ 分布式会话锁（agent.collaboration.lock.type=redis）；infra 中为 optional 需在此显式引入，
             相关配置由 @ConditionalOnClass 保护，未配置 storage.type=db / lock.type=redis 时不启用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- PDF 文档解析（RAG 上传 .pdf 时使用；与 infra 的 optional 同版本，此处显式引入以在 example-web 启用） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>
        <!-- Word(.docx) 文档解析（RAG 上传 .docx 时使用；同上） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
