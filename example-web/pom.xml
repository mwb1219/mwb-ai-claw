<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.mwb1219</groupId>
        <artifactId>mwb-ai-claw-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>example-web</artifactId>
    <packaging>jar</packaging>
    <name>example-web</name>
    <description>Web 服务端示例：演示 mwb-ai-claw Spring Boot Starter 的 REST / SSE / WebSocket 接入方式</description>

    <properties>
        <!-- 示例工程不发布到 Maven 仓库 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- 框架 Starter：自动装配记忆 / LLM / 工具 / 编排 / 存储 / REST / WebSocket -->
        <dependency>
            <groupId>io.github.mwb1219</groupId>
            <artifactId>mwb-ai-claw-spring-boot-starter</artifactId>
        </dependency>

        <!-- Web 服务端容器（spring.profiles.active=web 默认激活） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- JDBC 存储（agent.storage.type=db）：嵌入式 H2（联调用，MySQL 兼容模式）+ 生产 MySQL 驱动 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 生产 MySQL：切换 DB_DRIVER=com.mysql.cj.jdbc.Driver 即用（见 application.yml） -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- PostgreSQL 驱动（RAG provider=pgvector 向量库 / 存储 db 后端；版本由 spring-boot-dependencies BOM 管理） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Redis 分布式会话锁（agent.collaboration.lock.type=redis，多实例部署；infra 中为 optional 需在此显式引入，
             RedisLockConfiguration 由 @ConditionalOnClass 保护，未配置 type=redis 时不启用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- PDF 文档解析（RAG 上传 .pdf 时使用；与 infra 的 optional 同版本，此处显式引入以在 example-web 启用） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>
        <!-- Word(.docx) 文档解析（RAG 上传 .docx 时使用；同上） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
