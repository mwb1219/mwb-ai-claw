# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会提交）

# 默认模型
DEFAULT_MODEL=deepseek-chat
DEFAULT_BASE_URL=https://api.deepseek.com
DEFAULT_API_KEY=

# coder 专家（独立模型，留空则继承 DEFAULT_MODEL / DEFAULT_BASE_URL / DEFAULT_API_KEY）
CODER_MODEL=
CODER_BASE_URL=
CODER_API_KEY=

# researcher 专家
RESEARCHER_MODEL=
RESEARCHER_BASE_URL=
RESEARCHER_API_KEY=

# 向量检索 Embedding（Phase 3；留空则继承默认模型配置。
# 注意：DeepSeek 主模型不支持 embeddings，要启用向量检索需配置专用 embedding 服务，
# 如 OpenAI 兼容的 text-embedding-3-small（base-url 形如 https://api.openai.com/v1）。
# 未配置时向量调用自动降级，hybrid 检索回退关键词。）
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 独立 RAG 知识库 Embedding（agent.rag.embedding.*；与记忆 Embedding 相互独立，可复用同一模型服务）
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=

# 小模型提炼（Phase 4 成本优化；留空继承 DEFAULT_MODEL / DEFAULT_BASE_URL / DEFAULT_API_KEY，
# 可配置更便宜的小模型（如 deepseek-chat）做摘要/事实提取，降低提炼成本）
SYNTHESIS_MODEL=
SYNTHESIS_BASE_URL=
SYNTHESIS_API_KEY=

# 提炼任务队列（Phase 1：分布式记忆提炼一致性，agent.memory.synthesis-queue-type）
# auto（默认，跟随 STORAGE_TYPE：file→local、db→redis）| local（进程内单线程）| redis（分布式锁，多实例推荐）
# SYNTHESIS_QUEUE_TYPE=auto
# SYNTHESIS_LOCK_TTL_SECONDS=600       # 合成锁 TTL（秒），LLM 长上下文时可放大
# SYNTHESIS_LOCK_WATCHDOG_INTERVAL=200 # watchdog 续期间隔（秒，默认 1/3 TTL）

# 存储后端（agent.storage.type）：file（本地文件，零依赖）| db（MySQL 持久化 + Redis Stack 召回：会话/记忆/知识库落库，需配数据库）
# 本示例默认 db：记忆/知识库落库到 MySQL，召回走 Redis Stack（RediSearch）
# STORAGE_TYPE=db

# ===== 数据库：MySQL（agent.storage.type=db 权威存储；docker compose up -d 启动）=====
# 首次初始化自动执行 docker-entrypoint-initdb.d 目录脚本（db/mysql/*.sql：框架表 + claw_user）
DB_URL=jdbc:mysql://localhost:3306/clawdb?useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=
DB_DRIVER=com.mysql.cj.jdbc.Driver
# SQL 初始化：never（MySQL 建表由 docker initdb 完成，关闭应用侧执行）| embedded（仅嵌入式 H2 执行）
SQL_INIT_MODE=never

# ===== Redis（召回索引 + 分布式会话锁；docker compose up -d 启动）=====
# RAG 召回形态：auto（跟随 STORAGE_TYPE：file→local，db→redis）| redis（显式声明，与 auto+db 等价）
RAG_PROVIDER=auto
REDIS_INDEX_PREFIX=claw
LOCK_TYPE=redis
REDIS_URI=redis://localhost:6379
LOCK_KEY_PREFIX=claw:lock:

# ===== 可观测性（agent.observability.*）=====
# 运行用量摘要：local（默认，JSONL 文件，零依赖）| db（落 claw_run_usage 表，与会话/记忆/RAG 同库，多实例共享，生产推荐）
RUN_USAGE_STORE=db
# 步骤级 trace：store=local（默认，本地 JSON，零依赖）| db（落 claw_trace 表，多实例共享，生产推荐）
TRACE_ENABLED=true
TRACE_STORE=db
