# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会提交）

# 默认模型
DEFAULT_MODEL=deepseek-chat
DEFAULT_BASE_URL=https://api.deepseek.com
DEFAULT_API_KEY=

# coder 专家（独立模型，留空则继承 DEFAULT_MODEL / DEFAULT_BASE_URL / DEFAULT_API_KEY）
CODER_MODEL=
CODER_BASE_URL=
CODER_API_KEY=

# researcher 专家
RESEARCHER_MODEL=
RESEARCHER_BASE_URL=
RESEARCHER_API_KEY=

# 向量检索 Embedding（Phase 3；留空则继承默认模型配置。
# 注意：DeepSeek 主模型不支持 embeddings，要启用向量检索需配置专用 embedding 服务，
# 如 OpenAI 兼容的 text-embedding-3-small（base-url 形如 https://api.openai.com/v1）。
# 未配置时向量调用自动降级，hybrid 检索回退关键词。）
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 独立 RAG 知识库 Embedding（agent.rag.embedding.*；与记忆 Embedding 相互独立，可复用同一模型服务）
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=

# 小模型提炼（Phase 4 成本优化；留空继承 DEFAULT_MODEL / DEFAULT_BASE_URL / DEFAULT_API_KEY，
# 可配置更便宜的小模型（如 deepseek-chat）做摘要/事实提取，降低提炼成本）
SYNTHESIS_MODEL=
SYNTHESIS_BASE_URL=
SYNTHESIS_API_KEY=

# 存储后端（agent.storage.type）：file（本地文件，零依赖）| db（JDBC 持久化：会话/长期记忆/记忆页落库，需配数据库）
# 本示例默认 db：会话/记忆落库到 PostgreSQL（与 RAG 共用）记忆存储文件持久化默认 file 为本地文件
# STORAGE_TYPE=db

# ===== 数据库：PostgreSQL + pgvector（T4 RAG 向量库 / 记忆落库(STORAGE_TYPE=db)；docker compose up -d 启动）=====
# 首次初始化自动执行 docker/initdb/01-pgvector.sql（启用 vector 扩展 + 建 claw_user 与记忆四表）
DB_URL=jdbc:postgresql://localhost:5432/clawdb
DB_USERNAME=claw
DB_PASSWORD=claw
DB_DRIVER=org.postgresql.Driver
# SQL 初始化：never（PG 建表由 docker initdb 完成，关闭应用侧执行）| embedded（仅嵌入式 H2 执行）
SQL_INIT_MODE=never
# 可选：切换 MySQL（agent.storage.type=db 或自建用户表时），注释掉上面 PG 段并填下列 MySQL 连接
# DB_URL=jdbc:mysql://localhost:3306/clawdb?useSSL=false&serverTimezone=Asia/Shanghai
# DB_USERNAME=root
# DB_PASSWORD=

# ===== Redis 分布式会话锁（T3 agent.collaboration.lock.type=redis；docker compose up -d 启动）=====
# 无 Redis 环境可切 LOCK_TYPE=local（JVM 内 ReentrantLock，单实例）
LOCK_TYPE=redis
REDIS_URI=redis://localhost:6379
LOCK_KEY_PREFIX=claw:lock:
