# ============================================================
# .dockerignore（example-web 目录）：独立镜像构建上下文过滤
# 构建上下文 = example-web 目录（docker compose build context: .）
# ============================================================

# 构建产物
target/
**/target/

# 密钥与环境变量（根目录 .env 供 docker compose env_file 使用，不进入镜像）
# 注意：仅排除根目录 .env；src/main/resources/.env 需保留 —— Dockerfile 构建时会复制进镜像 /app
# 供实例启动后加载（agents.json / orchestrations.json / mcp-server.json 同理）
/.env

# 日志与运行数据
logs/
**/*.log

# 文档 / 截图 / 数据库初始化脚本（镜像不需要：mysql initdb 由 compose 挂载宿主目录完成）
**/*.md
screenshots/
db/

# IDE
.idea
.vscode
*.iml
.DS_Store
