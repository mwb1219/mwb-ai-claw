# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会提交）

# 默认模型
DEFAULT_MODEL=deepseek-chat
DEFAULT_BASE_URL=https://api.deepseek.com
DEFAULT_API_KEY=

# coder 专家（独立模型，留空则继承 DEFAULT_MODEL / DEFAULT_API_KEY）
CODER_MODEL=
CODER_API_KEY=

# researcher 专家
RESEARCHER_MODEL=
RESEARCHER_API_KEY=

# 向量检索 Embedding（Phase 3；留空则继承默认模型配置。
# 注意：DeepSeek 主模型不支持 embeddings，要启用向量检索需配置专用 embedding 服务，
# 如 OpenAI 兼容的 text-embedding-3-small（base-url 形如 https://api.openai.com/v1）。
# 未配置时向量调用自动降级，hybrid 检索回退关键词。）
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 小模型提炼（Phase 4 成本优化；留空继承 DEFAULT_MODEL / DEFAULT_BASE_URL / DEFAULT_API_KEY，
# 可配置更便宜的小模型（如 deepseek-chat）做摘要/事实提取，降低提炼成本）
SYNTHESIS_MODEL=
SYNTHESIS_BASE_URL=
SYNTHESIS_API_KEY=

# 存储后端（agent.storage.type）：file（默认，本地文件）| db（JDBC 持久化，需配下面 DB_* 变量）
# STORAGE_TYPE=file
# 数据库（agent.storage.type=db 时生效；默认嵌入式 H2，MySQL 兼容模式，数据重启清空，仅联调用）
# 生产 MySQL：取消注释并填入连接信息，并先手动执行 start/src/main/resources/schema.sql 建表
# 注意：取消注释后应用启动即会连接数据库，请先确保 MySQL 已启动可达
# DB_URL=jdbc:mysql://localhost:3306/clawdb?useSSL=false&serverTimezone=Asia/Shanghai
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# SQL 初始化模式：embedded（默认，仅嵌入式 H2 执行）| never（关闭）
# SQL_INIT_MODE=embedded
