# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会提交）

# 默认模型
DEFAULT_MODEL=deepseek-chat
DEFAULT_BASE_URL=https://api.deepseek.com
DEFAULT_API_KEY=

# coder 专家（独立模型，留空则继承 DEFAULT_MODEL / DEFAULT_BASE_URL / DEFAULT_API_KEY）
CODER_MODEL=
CODER_BASE_URL=
CODER_API_KEY=

# researcher 专家
RESEARCHER_MODEL=
RESEARCHER_BASE_URL=
RESEARCHER_API_KEY=

# 向量检索 Embedding（Phase 3；留空则继承默认模型配置。
# 注意：DeepSeek 主模型不支持 embeddings，要启用向量检索需配置专用 embedding 服务，
# 如 OpenAI 兼容的 text-embedding-3-small（base-url 形如 https://api.openai.com/v1）。
# 未配置时向量调用自动降级，hybrid 检索回退关键词。）
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 独立 RAG 知识库 Embedding（agent.rag.embedding.*；与记忆 Embedding 相互独立，可复用同一模型服务）
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=

# 小模型提炼（Phase 4 成本优化；留空继承 DEFAULT_MODEL / DEFAULT_BASE_URL / DEFAULT_API_KEY，
# 可配置更便宜的小模型（如 deepseek-chat）做摘要/事实提取，降低提炼成本）
SYNTHESIS_MODEL=
SYNTHESIS_BASE_URL=
SYNTHESIS_API_KEY=

# 存储后端（agent.storage.type）：file（默认，本地文件）| db（MySQL 存储 + Redis Stack 召回，需配下面 DB_* / Redis 变量）
# STORAGE_TYPE=file
# 数据库（agent.storage.type=db 时生效；默认嵌入式 H2，MySQL 兼容模式，数据重启清空，仅联调用）
# 生产 MySQL：取消注释并填入连接信息，并先手动执行 start/src/main/resources/schema.sql 建表
# 注意：取消注释后应用启动即会连接数据库，请先确保 MySQL 已启动可达
# DB_URL=jdbc:mysql://localhost:3306/clawdb?useSSL=false&serverTimezone=Asia/Shanghai
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# SQL 初始化模式：embedded（默认，仅嵌入式 H2 执行）| never（关闭）
# SQL_INIT_MODE=embedded

# Redis（db 形态召回索引 + Redis 分布式锁；连接优先复用 spring.data.redis.*，未配置时兜底 REDIS_URI）
# RAG_PROVIDER=auto           # RAG 索引实现：auto（默认，跟随 storage.type：file→local、db→redis）| redis
# REDIS_INDEX_PREFIX=claw     # Redis 召回索引 key 前缀（多环境/多租户共享 Redis 时隔离命名空间）
# LOCK_TYPE=local             # 会话锁：local（默认，JVM 内）| redis（多实例分布式锁，需引入 spring-boot-starter-data-redis）
# REDIS_URI=redis://localhost:6379   # Redis 连接（召回 + 分布式锁兜底）
# LOCK_KEY_PREFIX=claw:lock:  # 分布式锁 key 前缀

# 可观测性（run-usage 运行用量 / trace 步骤级链路）
# RUN_USAGE_STORE=local       # local（默认，JSONL 文件）| db（落 claw_run_usage 表，与会话/记忆/RAG 同库，生产推荐）
# TRACE_ENABLED=true          # 步骤级 trace 开关
# TRACE_STORE=local           # local（默认，本地 JSON）| db（落 claw_trace 表，生产推荐）

# 提炼任务队列（Phase 1：分布式记忆提炼一致性，agent.memory.synthesis-queue-type）
# auto（默认，跟随 storage.type：file→local、db→redis）| local（进程内单线程）| redis（分布式锁，多实例推荐）
# SYNTHESIS_QUEUE_TYPE=auto
# SYNTHESIS_LOCK_TTL_SECONDS=600       # 合成锁 TTL（秒），LLM 长上下文时可放大
# SYNTHESIS_LOCK_WATCHDOG_INTERVAL=200 # watchdog 续期间隔（秒，默认 1/3 TTL）

# 子代理动态生成（agent.subagent.*，H3 Agent-as-Tool，默认关闭）
# enabled=true 时 spawn_agent 工具以 global=true 注册进所有 Agent 工具集
# 子代理默认继承基座 Agent 模型/系统提示词，可被 spec 覆盖；允许的租户 id 用逗号分隔
# AGENT_SUBAGENT_ENABLED=false
# AGENT_SUBAGENT_BUDGET_TOKEN=0       # 每个子代理累计 token 预算（0 不限）
# AGENT_SUBAGENT_TIMEOUT_SECONDS=0    # 单次 spawn 超时（<=0 复用 agent.security.tool-timeout）
# AGENT_SUBAGENT_ALLOWED_TENANTS=     # 允许生成子代理的租户 id（空=全部）
# AGENT_SUBAGENT_MAX_DESCENDANTS=2    # 子代理最多可再嵌套深度（0 禁止嵌套，-1 不限）
# AGENT_SUBAGENT_ASYNC=false          # 异步 spawn（切片 2 增强，默认关闭）
