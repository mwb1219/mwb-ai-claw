<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         example-commerce 独立工程：不随 mwb-ai-claw 仓库 reactor 构建，单独管理版本号。
         框架依赖 mwb-ai-claw-spring-boot-starter:1.0.3（Central 正式版，Maven 自动下载）：
           - 本地运行：直接在 example-commerce 目录执行 mvn 命令即可；
           - Docker 构建：docker compose 构建时自动拉取 Central 依赖（additional_contexts 可选加速）。
         ============================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.mwb1219</groupId>
    <artifactId>example-commerce</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>example-commerce</name>
    <description>电商/营销运营助手示例（独立工程）：集中演示 mwb-ai-claw 的多扩展点（自定义工具 / RAG / 自定义编排 / 多模态 / 租户隔离 / 审批门禁）</description>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 框架版本：Central 正式版（升级框架后同步修改） -->
        <mwb-ai-claw.version>1.0.3</mwb-ai-claw.version>
    </properties>

    <dependencies>
        <!-- 框架 Starter：自动装配记忆 / LLM / 工具 / 编排 / 存储 / REST / WebSocket -->
        <dependency>
            <groupId>io.github.mwb1219</groupId>
            <artifactId>mwb-ai-claw-spring-boot-starter</artifactId>
            <version>${mwb-ai-claw.version}</version>
        </dependency>

        <!-- Web 服务端容器（spring.profiles.active=web 默认激活） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- JDBC 存储（agent.storage.type=db）：嵌入式 H2（联调用，MySQL 兼容模式）+ 生产 MySQL 驱动 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 生产 MySQL：DB_DRIVER=com.mysql.cj.jdbc.Driver（见 application.yml） -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
