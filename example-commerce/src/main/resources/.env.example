# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会提交）
# 加载顺序：运行目录（user.dir）→ 安装目录 → classpath

# 默认模型（marketing 专家继承）
DEFAULT_MODEL=deepseek-chat
DEFAULT_BASE_URL=https://api.deepseek.com
DEFAULT_API_KEY=

# marketing 营销专家（独立模型，留空则继承 DEFAULT_*）
MARKETING_MODEL=
MARKETING_BASE_URL=
MARKETING_API_KEY=

# 独立 RAG 知识库 Embedding（agent.rag.embedding.*，OpenAI 兼容 /embeddings）
# 启用 RAG 写入/检索需配置；未配置时 RAG 知识库能力不可用（不阻塞应用启动）
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=

# 鉴权开关（agent.auth.enabled）
AUTH_ENABLED=true

# 静态引导管理员 Key（兜底；本示例主要使用 CommerceTenantGateway 的店铺 Key）
# BOOTSTRAP_API_KEY=sk-admin-bootstrap