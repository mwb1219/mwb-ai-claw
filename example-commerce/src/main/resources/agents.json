      "maxSteps": 10,
      "maxTokens": 8192,
      "tools": ["list_products", "list_orders", "list_campaigns", "create_campaign"],
      "model": "${MARKETING_MODEL:${DEFAULT_MODEL:deepseek-chat}}",
      "baseUrl": "${MARKETING_BASE_URL:${DEFAULT_BASE_URL:https://api.deepseek.com}}",
      "apiKey": "${MARKETING_API_KEY:${DEFAULT_API_KEY:}}"
