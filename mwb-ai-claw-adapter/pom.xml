<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.mwb1219</groupId>
        <artifactId>mwb-ai-claw-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mwb-ai-claw-adapter</artifactId>
    <packaging>jar</packaging>
    <name>mwb-ai-claw-adapter</name>
    <description>mwb-ai-claw-adapter: 适配层，将核心能力适配为 REST / WebSocket / Spring Boot 等外部接口。</description>
    <url>https://github.com/mwb1219/mwb-ai-claw</url>

    <dependencies>
        <dependency>
            <groupId>io.github.mwb1219</groupId>
            <artifactId>mwb-ai-claw-app</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- JLine: 终端 REPL 交互（Shell 模式） -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>3.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 4 测试运行所需（Spring Boot 2.4+ 已从 starter-test 移除 vintage engine） -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
