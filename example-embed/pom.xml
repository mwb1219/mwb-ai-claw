<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mwb.ai.claw</groupId>
        <artifactId>mwb-ai-claw-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>example-embed</artifactId>
    <packaging>jar</packaging>
    <name>example-embed</name>
    <description>客户端嵌入式示例：演示 ClawRuntime 在无 Web 容器的 JVM 应用中直接调用 Agent 能力</description>

    <properties>
        <!-- 示例工程不发布到 Maven 仓库 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.mwb.ai.claw</groupId>
            <artifactId>mwb-ai-claw-app</artifactId>
        </dependency>
        <!-- 直接使用 domain 的流式回调类型（LlmStreamCallback / LlmResponse），显式声明 -->
        <dependency>
            <groupId>com.mwb.ai.claw</groupId>
            <artifactId>mwb-ai-claw-domain</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
