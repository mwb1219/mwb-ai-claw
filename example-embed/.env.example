# 复制本文件为 .env 并填入真实密钥（运行目录 .env 优先于系统环境变量，已被 .gitignore 排除）
# cp example-embed/.env.example example-embed/.env
# 再执行：mvn -pl example-embed exec:java -Dexec.mainClass=com.mwb.ai.claw.example.embed.EmbedDemo

# 默认模型
DEFAULT_MODEL=deepseek-chat
DEFAULT_BASE_URL=https://api.deepseek.com/v1
DEFAULT_API_KEY=

# 向量检索 Embedding（可选：客户端嵌入场景如启用记忆向量检索，需配置专用 embedding 服务；
# 留空时向量调用自动降级，hybrid 检索回退关键词）
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 小模型提炼（可选：成本优化；留空继承 DEFAULT_MODEL / DEFAULT_BASE_URL / DEFAULT_API_KEY）
SYNTHESIS_MODEL=
SYNTHESIS_BASE_URL=
SYNTHESIS_API_KEY=
